# Fine-grained personal access token, read-only, no repo write scopes.
# Public repo metadata only is enough for the commit feed.
GITHUB_TOKEN=ghp_replace_me
GITHUB_USERNAME=cheazer

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cache lifetime for GitHub responses, in seconds
ACTIVITY_CACHE_TTL=1800

PORT=4000

# Contact form. Without these the API logs messages instead of emailing them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
